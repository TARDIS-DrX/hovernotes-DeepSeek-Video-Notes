{
  "manifest_version": 3,
  "name": "DeepSeek Video Notes",
  "version": "0.1.0",
  "description": "Capture a browser video, pick key frames by scene change, and turn them into Obsidian notes with DeepSeek vision.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.deepseek.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "DeepSeek Video Notes"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "assets/icons/icon32.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
